# Copy to .env (already gitignored) and fill in real values.

# console.anthropic.com API key, used by flux.agent.llm_client for the
# discovery loop's LLM calls (Claude, tool-calling over the accessibility
# tree). Not needed for mock_bank, replay, or the test suite.
ANTHROPIC_API_KEY=

# Optional: override the model used for discovery.
FLUX_MODEL=claude-sonnet-4-5
